# Zero-config release — copy to `.env.production.local` before `pnpm tauri build`.
# Keys are compiled into the app; users never open Settings.

VITE_LYRA_ZERO_CONFIG=true

# At least one of zhipu / deepseek (both recommended for best routing).
VITE_ZHIPU_API_KEY=
VITE_DEEPSEEK_API_KEY=
VITE_ANTHROPIC_API_KEY=
# Default provider — fxb (SupaNet) OpenAI-compatible gateway, deepseek-v4-flash.
VITE_FXB_API_KEY=

# Optional — lyrics embedding refill
# VITE_ZHIPU_EMBEDDING_API_KEY=
